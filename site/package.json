    "build": "npm run sync && astro build && node scripts/check-links.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.10",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.4.11",
    "astro-mermaid": "2.2.0",
    "mermaid": "12.3.0"
  }
}
