{
  "name": "vesper-site",
  "private": true,
  "type": "module",
  "description": "The documentation site of Vesper, built from docs/ with Astro Starlight.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
